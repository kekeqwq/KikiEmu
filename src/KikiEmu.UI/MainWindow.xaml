<Window x:Class="KikiEmu.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KikiEmu Viewport"
        Width="430" Height="860"
        MinWidth="320" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#f1f5f9"
        FontFamily="Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        PreviewTouchDown="Window_PreviewTouchDown"
        PreviewTouchMove="Window_PreviewTouchMove"
        PreviewTouchUp="Window_PreviewTouchUp">

    <Grid x:Name="RootGrid" Background="#000000">
        <!-- ========================================================================= -->
        <!-- Native Android Display Viewport (纯显示画布，1:1 点对点显示 Android 真实系统)  -->
        <!-- ========================================================================= -->
        <Viewbox x:Name="ViewportBox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="ViewportContainer" Width="1080" Height="2400" Background="#000000">
                <!-- Native Render Output Host (VirtIO-GPU / DRM / Framebuffer Direct Surface) -->
                <Image x:Name="NativeDisplayImage" 
                       Stretch="Fill" 
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderOptions.EdgeMode="Aliased" />

                <!-- Boot / Connecting Screen (仅在底层原生画面未就绪时显示) -->
                <Grid x:Name="BootSplashGrid" Background="#050811" Visibility="Visible" MouseDown="BootSplashGrid_MouseDown" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="800">
                        <!-- Android 17 Clean Monogram -->
                        <Border Width="80" Height="80" CornerRadius="24" Background="#10b981" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock Text="17" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <TextBlock Text="Android 17" FontSize="26" FontWeight="SemiBold" Foreground="#f8fafc" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Snapdragon X Elite Oryon • ARM64 Native" FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <ProgressBar IsIndeterminate="True" Width="240" Height="4" Background="#1e293b" Foreground="#10b981" BorderThickness="0" Margin="0,0,0,16"/>
                        
                        <!-- 实时主状态 -->
                        <TextBlock x:Name="BootStatusText" Text="正在点亮原生渲染总线..." FontSize="13" FontWeight="Medium" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        
                        <!-- 详细阶段提示 -->
                        <TextBlock x:Name="BootDetailText" Text="正在准备存储与内核..." FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <!-- 交互快捷操作提示 -->
                        <Border Background="#111827" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center" BorderBrush="#1f2937" BorderThickness="1">
                            <TextBlock Text="💡 提示：点击屏幕任意处或按空格键可随时进入纯画布模式" FontSize="11" Foreground="#9ca3af" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- ========================================================================= -->
        <!-- Floating Test Diagnostics HUD (按 F12 或 Ctrl+H 开关，不干扰纯粹沉浸式显示)        -->
        <!-- ========================================================================= -->
        <Border x:Name="DiagnosticsHud"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16" Padding="14,10"
                Background="#cc090d16" CornerRadius="12"
                BorderBrush="#334155" BorderThickness="1"
                Visibility="Visible"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#10b981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="KikiEmu Native Viewport" FontSize="11" FontWeight="Bold" Foreground="#f1f5f9"/>
                </StackPanel>
                <TextBlock x:Name="HudResolutionText" Text="Mode: 1080x2400 (Phone 9:20)" FontSize="10" Foreground="#94a3b8" Margin="0,1"/>
                <TextBlock x:Name="HudRefreshText" Text="Refresh: 120Hz Point-to-Point" FontSize="10" Foreground="#38bdf8" Margin="0,1"/>
                <TextBlock x:Name="HudArchText" Text="Core: Oryon Direct Pass-through" FontSize="10" Foreground="#34d399" Margin="0,1"/>
                <TextBlock x:Name="HudKernelText" Text="Kernel: Linux 7.3 Mainline (16K Page)" FontSize="10" Foreground="#a78bfa" Margin="0,1"/>
                <TextBlock Text="[Space/Click] 切换蒙版  [F11] 全屏  [F12] 开关HUD" FontSize="9" Foreground="#64748b" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
