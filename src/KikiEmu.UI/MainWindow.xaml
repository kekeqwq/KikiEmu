<Window x:Class="KikiEmu.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KikiEmu" 
        Height="860" Width="430"
        WindowStartupLocation="CenterScreen"
        Background="#18181b"
        Foreground="#fafafa"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent Titlebar -->
        <Grid Grid.Row="0" Background="#27272a" MouseDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="20" Height="20" CornerRadius="5" Background="#6366f1" Margin="0,0,8,0">
                    <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleTextBlock" Text="KikiEmu" FontWeight="SemiBold" FontSize="13" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                <Border Background="#3f3f46" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                    <TextBlock x:Name="ModeBadge" Text="竖屏手机" FontSize="10" Foreground="#a1a1aa" FontWeight="Medium"/>
                </Border>
            </StackPanel>

            <!-- Titlebar Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Toggle Fullscreen / Tablet Mode -->
                <Button x:Name="FullscreenBtn" Width="40" Height="40" Style="{StaticResource TitlebarButtonStyle}" Click="FullscreenBtn_Click" ToolTip="平板全屏模式 (F11)">
                    <TextBlock Text="⛶" FontSize="14" Foreground="#a1a1aa"/>
                </Button>
                <!-- Minimize -->
                <Button Width="40" Height="40" Style="{StaticResource TitlebarButtonStyle}" Click="MinimizeBtn_Click">
                    <TextBlock Text="—" FontSize="11" Foreground="#a1a1aa"/>
                </Button>
                <!-- Close -->
                <Button Width="46" Height="40" Style="{StaticResource TitlebarCloseButtonStyle}" Click="CloseBtn_Click">
                    <TextBlock Text="✕" FontSize="11" Foreground="#a1a1aa"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Display / Viewport Area -->
        <Grid Grid.Row="1" Background="#09090b">
            <!-- Running Emulator Container -->
            <Border x:Name="DisplayContainer" Background="#000000" Focusable="True"
                    TouchDown="DisplayContainer_TouchDown"
                    TouchMove="DisplayContainer_TouchMove"
                    TouchUp="DisplayContainer_TouchUp"
                    MouseDown="DisplayContainer_MouseDown">
                <!-- Host Window / Render target will be attached here -->
            </Border>

            <!-- Empty State / Guide Panel (Shown when no default instance configured) -->
            <Grid x:Name="EmptyStatePanel" Visibility="Collapsed" Background="#18181b">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <Border Width="64" Height="64" CornerRadius="16" Background="#312e81" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="📱" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="尚未配置默认 Android 实例" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#f4f4f5"/>
                    <TextBlock Text="KikiEmu 桌面端专注于极简启动与原生效能呈现，实例生命周期请在终端中管理：" 
                               FontSize="12" Foreground="#a1a1aa" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" LineHeight="18"/>

                    <!-- Code Snippet Box -->
                    <Border Background="#27272a" CornerRadius="8" Padding="14" Margin="0,0,0,20" BorderBrush="#3f3f46" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="# 1. 创建 Android 17 机器" FontSize="11" Foreground="#71717a" FontFamily="Consolas, monospace"/>
                            <TextBox Text="kikiemu create --storage ~/myandroid --system android17 --id 1" 
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#38bdf8" 
                                     FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>

                            <TextBlock Text="# 2. 设为默认启动实例" FontSize="11" Foreground="#71717a" FontFamily="Consolas, monospace"/>
                            <TextBox Text="kikiemu set --default 1" 
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#38bdf8" 
                                     FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="检查并重试启动" Height="38" Background="#4f46e5" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Click="RetryCheckBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Spinner / Booting Overlay -->
            <Grid x:Name="BootingOverlay" Visibility="Collapsed" Background="#e0000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,0,0,16" Foreground="#6366f1" Background="#27272a" BorderThickness="0"/>
                    <TextBlock x:Name="BootingStatusText" Text="正在调起 ARM64 虚拟化硬件..." FontSize="13" Foreground="#d4d4d8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Grid Grid.Row="2" Background="#1c1917" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Peripheral & Input Status -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="⌨️ 物理外设键盘: " FontSize="11" Foreground="#78716c"/>
                <TextBlock x:Name="KeyboardStatusText" Text="已直通" FontSize="11" Foreground="#22c55e" FontWeight="SemiBold"/>
                <TextBlock Text="  |  👆 10点触控" FontSize="11" Foreground="#78716c" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Refresh Rate & Mode -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="⚡ 120Hz V-Sync" FontSize="11" Foreground="#a855f7" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>

    <Window.Resources>
        <!-- Titlebar buttons -->
        <Style x:Key="TitlebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3f3f46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitlebarCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
