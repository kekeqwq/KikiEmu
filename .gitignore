# Runtime orchestration and QEMU source patches are tracked here. Built images,
# QEMU source/build trees, screenshots and old experiments stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/GPU_ACCELERATION.md
!/patches/
/patches/*
!/patches/qemu-windows-gtk-full-redraw.patch
!/patches/qemu-windows-arm64-gtk-touch.patch
!/patches/qemu-windows-gtk-glarea-wgl.patch
!/profiles/
/profiles/*
!/profiles/launcher3-settings-20260926.json
!/profiles/network-audio-20260926.json
!/profiles/gpu-virgl-20260927.json
!/tools/
/tools/*
!/tools/build_qemu_arm64.sh
!/tools/collect_kikiaosp_assets.ps1
!/tools/run_kikiaosp_touch_local.ps1
!/tools/capture_qemu_window.ps1
!/tools/probe_wgl_adreno.c
