# Keep source patches byte-compatible with git apply in MSYS2.
# Unified diffs require a space prefix even on empty context lines.
/patches/*.patch text eol=lf whitespace=-blank-at-eol
/tools/*.sh text eol=lf
/tools/*.ps1 text eol=lf
/build.ps1 text eol=lf
/profiles/*.json text eol=lf
/README.md text eol=lf
/QEMU_BUILD.md text eol=lf
/QUICK_START.md text eol=lf
/CANDIDATE_TEST_20261001.md text eol=lf
/CAMERA_SUPPORT.md text eol=lf
/GPU_ACCELERATION.md text eol=lf
/BASELINE_20260930.md text eol=lf
/BOOT_CONSOLE.md text eol=lf
/RELEASE_PLAN.md text eol=lf
/LICENSE text eol=lf
/LICENSING.md text eol=lf
/src/** text eol=lf
/tests/** text eol=lf
/assets/*.png binary
/assets/*.ico binary
/assets/*.md text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
