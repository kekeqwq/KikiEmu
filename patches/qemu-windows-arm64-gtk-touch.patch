+static void gd_kiki_apply_native_scale(GtkWidget *widget, VirtualConsole *vc,
+                                       int ww_widget, int wh_widget,
+                                       int fbw, int fbh)
+{
+#ifdef G_OS_WIN32
+    int scale_factor, window_px_w, window_px_h, dw, dh;
+    double sx, sy, fit;
+
+    if (g_strcmp0(g_getenv("KIKI_GTK_NATIVE_PIXELS"), "1") != 0 ||
+        fbw <= 0 || fbh <= 0 || ww_widget <= 0 || wh_widget <= 0) {
+        return;
+    }
+
+    scale_factor = MAX(gtk_widget_get_scale_factor(widget), 1);
+    window_px_w = ww_widget * scale_factor;
+    window_px_h = wh_widget * scale_factor;
+    dw = fbw > window_px_w ? fbw - window_px_w : window_px_w - fbw;
+    dh = fbh > window_px_h ? fbh - window_px_h : window_px_h - fbh;
+    if (dw <= 2 && dh <= 2) {
+        vc->gfx.scale_x = 1.0 / scale_factor;
+        vc->gfx.scale_y = 1.0 / scale_factor;
+        return;
+    }
+
+    /*
+     * The host window and guest scanout disagree while a mode change is in
+     * flight. Fit the complete frame instead of clipping its top-left corner.
+     * Drawing returns to one guest pixel per host pixel once the sizes match.
+     */
+    sx = (double)ww_widget / fbw;
+    sy = (double)wh_widget / fbh;
+    fit = sx < sy ? sx : sy;
+    vc->gfx.scale_x = fit;
+    vc->gfx.scale_y = fit;
+#else
+    (void)widget;
+    (void)vc;
+    (void)ww_widget;
+    (void)wh_widget;
+    (void)fbw;
+    (void)fbh;
+#endif
+}
