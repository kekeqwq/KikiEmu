+            kiki_gl_profile.queue_total_us +=
+                profile_start_us - kiki_gl_profile.last_flush_us;
+            kiki_gl_profile.queue_samples++;
+            kiki_gl_profile.last_flush_us = 0;
+        }
+    }
 
     if (!vc->gfx.gls || !vc->gfx.ds) {
         return;
@@ -135,6 +268,14 @@ void gd_gl_area_draw(VirtualConsole *vc)
         surface_gl_setup_viewport(vc->gfx.gls, vc->gfx.ds, pw, ph);
         surface_gl_render_texture(vc->gfx.gls, vc->gfx.ds);
     }
+
+    if (profile_start_us) {
