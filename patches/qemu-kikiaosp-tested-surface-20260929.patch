+static void sdl2_update_ui_info(struct sdl2_console *scon, bool delay)
+{
+    QemuUIInfo info;
+    int width, height;
+    const char *refresh_env;
+    int refresh_rate = 0;
+
+    if (!scon->real_window ||
+        !qemu_console_ui_info_supported(scon->dcl.con)) {
+        return;
+    }
+
+    SDL_GetWindowSize(scon->real_window, &width, &height);
+#ifdef CONFIG_OPENGL
+    if (scon->opengl) {
+        SDL_GL_GetDrawableSize(scon->real_window, &width, &height);
+    }
+#endif
+
+    refresh_env = g_getenv("KIKI_SDL_GUEST_REFRESH_RATE_HZ");
+    if (refresh_env && *refresh_env) {
+        char *end = NULL;
+        gint64 refresh_hz = g_ascii_strtoll(refresh_env, &end, 10);
+
+        if (end != refresh_env && !*end &&
+            refresh_hz >= 30 && refresh_hz <= 120) {
+            refresh_rate = refresh_hz * 1000;
+        }
+    }
+
+    info = *qemu_console_get_ui_info(scon->dcl.con);
+    info.width = width;
+    info.height = height;
+    info.refresh_rate = refresh_rate;
+    qemu_console_set_ui_info(scon->dcl.con, &info, delay);
+}
