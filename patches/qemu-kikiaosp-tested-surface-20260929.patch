+            "fps=%.2f frame_p50=%.3fms frame_p95=%.3fms frame_p99=%.3fms "
+            "stalls33=%u stalls50=%u stalls100=%u idle_gaps=%u "
+            "draw_avg=%.3fms draw_max=%.3fms queue_avg=%.3fms\n",
+            elapsed_us / 1000000.0, kiki_gl_profile.flushes, kiki_gl_profile.renders,
+            kiki_gl_profile.renders * 1000000.0 / elapsed_us,
+            p50_ms, p95_ms, p99_ms,
+            kiki_gl_profile.stalls_33ms,
+            kiki_gl_profile.stalls_50ms,
+            kiki_gl_profile.stalls_100ms,
+            kiki_gl_profile.idle_gaps,
+            kiki_gl_profile.renders ?
+                kiki_gl_profile.draw_total_us / (1000.0 * kiki_gl_profile.renders) : 0.0,
+            kiki_gl_profile.draw_max_us / 1000.0,
+            kiki_gl_profile.queue_samples ?
+                kiki_gl_profile.queue_total_us / (1000.0 * kiki_gl_profile.queue_samples) : 0.0);
+    if (profile_output != stderr) {
+        fclose(profile_output);
+    }
