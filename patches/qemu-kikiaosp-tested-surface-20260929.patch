+static void sdl2_disable_window_ime(SDL_Window *window)
+{
+    typedef BOOL (WINAPI *ImmAssociateContextExFunc)(HWND, HANDLE, DWORD);
+    SDL_SysWMinfo info;
+    HMODULE imm32;
+    ImmAssociateContextExFunc associate;
+
+    if (!sdl2_disable_host_ime || !window) {
+        return;
+    }
+    memset(&info, 0, sizeof(info));
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window, &info) ||
+        info.subsystem != SDL_SYSWM_WINDOWS) {
+        return;
+    }
+    imm32 = LoadLibraryW(L"imm32.dll");
+    if (!imm32) {
+        sdl2_touch_trace_event("IME_DISABLE_FAILED", info.info.win.window,
+                               0, -1, 0, GetLastError(),
+                               "could not load imm32.dll");
+        return;
+    }
+    associate = (ImmAssociateContextExFunc)GetProcAddress(
+        imm32, "ImmAssociateContextEx");
+    if (!associate || !associate(info.info.win.window, NULL, 0)) {
+        sdl2_touch_trace_event("IME_DISABLE_FAILED", info.info.win.window,
+                               0, -1, 0, GetLastError(),
+                               "ImmAssociateContextEx failed");
+    } else {
+        sdl2_touch_trace_event("IME_DISABLED", info.info.win.window,
+                               0, -1, 0, 0,
+                               "host IME detached for physical key events");
+    }
+    FreeLibrary(imm32);
+}
+
+static int sdl2_raw_keyboard_event_watch(void *opaque, SDL_Event *event)
+{
+    SDL_SysWMmsg *sysmsg;
+    RAWINPUT input;
+    UINT size = sizeof(input);
+    UINT result;
+    RAWKEYBOARD *key;
+    char detail[96];
+
+    if (event->type == SDL_KEYDOWN || event->type == SDL_KEYUP) {
+        snprintf(detail, sizeof(detail),
+                 "window=%u scancode=%d keycode=%d mod=0x%x repeat=%u",
+                 event->key.windowID, event->key.keysym.scancode,
+                 event->key.keysym.sym, event->key.keysym.mod,
+                 event->key.repeat);
+        sdl2_touch_trace_event(event->type == SDL_KEYDOWN ? "SDL_KEYDOWN" :
+                               "SDL_KEYUP", NULL,
+                               event->key.keysym.sym, -1,
+                               event->key.keysym.scancode,
+                               event->key.keysym.mod, detail);
+        return 1;
+    }
+    if (event->type != SDL_SYSWMEVENT || !event->syswm.msg) {
+        return 1;
+    }
+    sysmsg = event->syswm.msg;
+    if (sysmsg->subsystem != SDL_SYSWM_WINDOWS) {
+        return 1;
+    }
+    if (sysmsg->msg.win.msg == WM_KEYDOWN ||
+        sysmsg->msg.win.msg == WM_KEYUP ||
+        sysmsg->msg.win.msg == WM_SYSKEYDOWN ||
+        sysmsg->msg.win.msg == WM_SYSKEYUP) {
+        snprintf(detail, sizeof(detail), "message=0x%04x vkey=0x%02x lparam=0x%08lx",
+                 sysmsg->msg.win.msg, (unsigned int)sysmsg->msg.win.wParam,
+                 (unsigned long)sysmsg->msg.win.lParam);
+        sdl2_touch_trace_event("WIN_KEY_MESSAGE", sysmsg->msg.win.hwnd,
+                               (UINT32)sysmsg->msg.win.wParam, -1,
+                               (LONG)sysmsg->msg.win.msg,
+                               (LONG)sysmsg->msg.win.lParam, detail);
+        return 1;
+    }
+    if (sysmsg->msg.win.msg == WM_IME_STARTCOMPOSITION ||
+        sysmsg->msg.win.msg == WM_IME_COMPOSITION ||
+        sysmsg->msg.win.msg == WM_IME_ENDCOMPOSITION ||
+        sysmsg->msg.win.msg == WM_IME_KEYDOWN ||
+        sysmsg->msg.win.msg == WM_CHAR ||
+        sysmsg->msg.win.msg == WM_UNICHAR) {
+        snprintf(detail, sizeof(detail), "message=0x%04x wparam=0x%08lx",
+                 sysmsg->msg.win.msg,
+                 (unsigned long)sysmsg->msg.win.wParam);
+        sdl2_touch_trace_event("WIN_IME_OR_CHAR_MESSAGE",
+                               sysmsg->msg.win.hwnd, 0, -1,
+                               (LONG)sysmsg->msg.win.msg,
+                               (LONG)sysmsg->msg.win.wParam, detail);
+        return 1;
+    }
+    if (sysmsg->msg.win.msg != WM_INPUT) {
+        return 1;
+    }
+
+    memset(&input, 0, sizeof(input));
+    result = GetRawInputData((HRAWINPUT)sysmsg->msg.win.lParam, RID_INPUT,
+                             &input, &size, sizeof(RAWINPUTHEADER));
+    if (result == (UINT)-1 || result < sizeof(RAWINPUTHEADER) ||
+        input.header.dwType != RIM_TYPEKEYBOARD) {
+        sdl2_touch_trace_event("WM_INPUT_READ_FAILED", sysmsg->msg.win.hwnd,
+                               0, -1, 0, 0,
+                               "raw keyboard data unavailable");
+        return 1;
+    }
+
+    key = &input.data.keyboard;
+    snprintf(detail, sizeof(detail), "vkey=0x%02x make=0x%02x flags=0x%04x %s",
+             key->VKey, key->MakeCode, key->Flags,
+             (key->Flags & RI_KEY_BREAK) ? "up" : "down");
+    sdl2_touch_trace_event("WM_INPUT_KEY", sysmsg->msg.win.hwnd,
+                           key->VKey, -1, key->MakeCode, key->Flags, detail);
+    return 1;
+}
+
+static void sdl2_enable_raw_keyboard_trace(void)
