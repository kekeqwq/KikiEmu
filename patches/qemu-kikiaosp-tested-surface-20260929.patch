+    kiki_gl_profile.last_flush_us = 0;
+    kiki_gl_profile.flushes = 0;
+    kiki_gl_profile.renders = 0;
+    kiki_gl_profile.queue_samples = 0;
+    kiki_gl_profile.interval_count = 0;
+    kiki_gl_profile.stalls_33ms = 0;
+    kiki_gl_profile.stalls_50ms = 0;
+    kiki_gl_profile.stalls_100ms = 0;
+    kiki_gl_profile.idle_gaps = 0;
+    kiki_gl_profile.draw_total_us = 0;
+    kiki_gl_profile.draw_max_us = 0;
+    kiki_gl_profile.queue_total_us = 0;
+    return G_SOURCE_CONTINUE;
+}
