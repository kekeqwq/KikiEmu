+/* Fade queued output samples to silence before tearing down the host device. */
+static void sdl_fade_sample(struct audio_pcm_info *info, uint8_t *p,
+                            size_t gain, size_t gain_max)
+{
+    switch (info->af) {
+    case AUDIO_FORMAT_S8: {
+        int8_t value;
+
+        memcpy(&value, p, sizeof(value));
+        value = (int8_t)((int64_t)value * gain / gain_max);
+        memcpy(p, &value, sizeof(value));
+        break;
+    }
+    case AUDIO_FORMAT_U8: {
+        int64_t value = (int64_t)*p - 128;
+
+        *p = (uint8_t)(value * gain / gain_max + 128);
+        break;
+    }
+    case AUDIO_FORMAT_S16:
+    case AUDIO_FORMAT_U16: {
+        uint16_t raw;
+        int64_t value;
+
+        memcpy(&raw, p, sizeof(raw));
+        if (info->swap_endianness) {
+            raw = bswap16(raw);
+        }
+        value = info->af == AUDIO_FORMAT_S16
+            ? (int16_t)raw : (int64_t)raw - INT16_MAX;
+        value = value * gain / gain_max;
+        raw = info->af == AUDIO_FORMAT_S16
+            ? (uint16_t)(int16_t)value : (uint16_t)(value + INT16_MAX);
+        if (info->swap_endianness) {
+            raw = bswap16(raw);
+        }
+        memcpy(p, &raw, sizeof(raw));
+        break;
+    }
+    case AUDIO_FORMAT_S32:
+    case AUDIO_FORMAT_U32: {
+        uint32_t raw;
+        int64_t value;
+
+        memcpy(&raw, p, sizeof(raw));
+        if (info->swap_endianness) {
+            raw = bswap32(raw);
+        }
+        value = info->af == AUDIO_FORMAT_S32
+            ? (int32_t)raw : (int64_t)raw - INT32_MAX;
+        value = value * gain / gain_max;
+        raw = info->af == AUDIO_FORMAT_S32
+            ? (uint32_t)(int32_t)value : (uint32_t)(value + INT32_MAX);
+        if (info->swap_endianness) {
+            raw = bswap32(raw);
+        }
+        memcpy(p, &raw, sizeof(raw));
+        break;
+    }
+    case AUDIO_FORMAT_F32: {
+        uint32_t raw;
+        float value;
+
+        memcpy(&raw, p, sizeof(raw));
+        if (info->swap_endianness) {
+            raw = bswap32(raw);
+        }
+        memcpy(&value, &raw, sizeof(value));
+        value *= (float)gain / gain_max;
+        memcpy(&raw, &value, sizeof(raw));
+        if (info->swap_endianness) {
+            raw = bswap32(raw);
+        }
+        memcpy(p, &raw, sizeof(raw));
+        break;
+    }
+    case AUDIO_FORMAT__MAX:
+        g_assert_not_reached();
+    }
+}
+
+static void sdl_fade_pending_out(SDLVoiceOut *sdl)
+{
+    HWVoiceOut *hw = &sdl->hw;
+    struct audio_pcm_info *info = &hw->info;
+    size_t frame_bytes = info->bytes_per_frame;
+    size_t sample_bytes = audio_format_bits(info->af) / 8;
+    size_t pending_frames, fade_frames, pos;
+
+    if (!frame_bytes || !sample_bytes || !hw->pending_emul || !hw->size_emul) {
+        return;
+    }
+
+    pending_frames = hw->pending_emul / frame_bytes;
+    fade_frames = MIN(pending_frames, (size_t)MAX(1, info->freq / 100));
+    pos = audio_ring_posb(hw->pos_emul, hw->pending_emul, hw->size_emul);
+    pos = (pos + (pending_frames - fade_frames) * frame_bytes) % hw->size_emul;
+
+    for (size_t i = 0; i < fade_frames; i++) {
+        for (int channel = 0; channel < info->nchannels; channel++) {
+            sdl_fade_sample(info,
+                            (uint8_t *)hw->buf_emul + pos + channel * sample_bytes,
+                            fade_frames - i - 1, fade_frames);
+        }
+        pos = (pos + frame_bytes) % hw->size_emul;
+    }
+}
+
 static void sdl_close_out(SDLVoiceOut *sdl)
 {
     if (sdl->initialized) {
+        HWVoiceOut *hw = &sdl->hw;
+        size_t pending_bytes;
+        int pending_ms, buffered_ms, drain_ms;
+
+        SDL_LockAudioDevice(sdl->devid);
+        sdl_fade_pending_out(sdl);
+        pending_bytes = hw->pending_emul;
+        pending_ms = hw->info.bytes_per_second
+            ? DIV_ROUND_UP(pending_bytes * 1000, hw->info.bytes_per_second) : 0;
+        buffered_ms = hw->info.freq
+            ? DIV_ROUND_UP(hw->samples * 1000, hw->info.freq) : 0;
+        drain_ms = MIN(250, MAX(30, pending_ms + buffered_ms));
+        sdl->exit = 0;
+        SDL_UnlockAudioDevice(sdl->devid);
+
+        /* Let SDL submit the faded tail and silence before closing the host
+         * endpoint, instead of stopping it on an arbitrary non-zero sample. */
+        SDL_PauseAudioDevice(sdl->devid, 0);
+        SDL_Delay(drain_ms);
+
         SDL_LockAudioDevice(sdl->devid);
         sdl->exit = 1;
         SDL_UnlockAudioDevice(sdl->devid);
