+static struct sdl2_console *get_scon_from_hwnd(HWND hwnd)
+{
+    int i;
+
+    for (i = 0; i < sdl2_num_outputs; i++) {
+        SDL_SysWMinfo info;
+
+        if (!sdl2_console[i].real_window) {
+            continue;
+        }
+        memset(&info, 0, sizeof(info));
+        SDL_VERSION(&info.version);
+        if (SDL_GetWindowWMInfo(sdl2_console[i].real_window, &info) &&
+            info.subsystem == SDL_SYSWM_WINDOWS &&
+            info.info.win.window == hwnd) {
+            return &sdl2_console[i];
+        }
+    }
+    return NULL;
+}
+
+static int sdl2_touch_slot_for_pointer(struct sdl2_console *scon,
+                                       UINT32 pointer_id, bool allocate)
+{
+    int i;
+    int free_slot = -1;
+
+    for (i = 0; i < INPUT_EVENT_SLOTS_MAX; i++) {
+        if (scon->touch_pointer_ids[i] == pointer_id) {
+            return i;
+        }
+        if (!scon->touch_pointer_ids[i] && free_slot < 0) {
+            free_slot = i;
+        }
+    }
+    if (allocate && free_slot >= 0) {
+        scon->touch_pointer_ids[free_slot] = pointer_id;
+        return free_slot;
+    }
+    return -1;
+}
+
+static void sdl2_end_pointer_touch(struct sdl2_console *scon, int slot,
+                                   HWND hwnd, UINT32 pointer_id,
+                                   const char *event)
+{
+    Error *err = NULL;
+    int i;
+    bool any_active = false;
+
+    if (slot < 0 || slot >= INPUT_EVENT_SLOTS_MAX ||
+        scon->touch_slots[slot].tracking_id == -1) {
+        return;
+    }
+
+    qemu_input_touch_event(scon->dcl.con, scon->touch_slots, slot,
+                           surface_width(scon->surface),
+                           surface_height(scon->surface),
+                           scon->touch_slots[slot].x,
+                           scon->touch_slots[slot].y,
+                           INPUT_MULTI_TOUCH_TYPE_END, &err);
+    if (err) {
+        warn_report_err(err);
+    }
+    scon->touch_pointer_ids[slot] = 0;
+    for (i = 0; i < INPUT_EVENT_SLOTS_MAX; i++) {
+        if (scon->touch_slots[i].tracking_id != -1) {
+            any_active = true;
+            break;
+        }
+    }
+    if (!any_active) {
+        qemu_input_queue_btn(scon->dcl.con, INPUT_BUTTON_TOUCH, false);
+        qemu_input_event_sync();
+    }
+    scon->touch_mouse_suppress_until = SDL_GetTicks() + 120;
+    sdl2_touch_trace_event(event, hwnd, pointer_id, slot,
+                           scon->touch_slots[slot].x,
+                           scon->touch_slots[slot].y, "end");
+}
+
+static bool sdl2_handle_windows_pointer(SDL_SysWMmsg *sysmsg)
+{
+    struct sdl2_console *scon;
+    POINTER_TOUCH_INFO touch_info;
+    POINTER_INPUT_TYPE pointer_type;
+    HWND hwnd;
+    UINT32 pointer_id;
+    UINT message;
+    int slot;
+    int drawable_w, drawable_h;
+    int x, y;
+    InputMultiTouchType type;
+    POINT point;
+    Error *err = NULL;
+
+    if (!sysmsg || sysmsg->subsystem != SDL_SYSWM_WINDOWS) {
+        return false;
+    }
+    hwnd = sysmsg->msg.win.hwnd;
+    message = sysmsg->msg.win.msg;
+    if (message != WM_POINTERDOWN && message != WM_POINTERUPDATE &&
+        message != WM_POINTERUP && message != WM_POINTERCAPTURECHANGED) {
+        return false;
+    }
+    pointer_id = GET_POINTERID_WPARAM(sysmsg->msg.win.wParam);
+    scon = get_scon_from_hwnd(hwnd);
+    if (!scon || !qemu_console_is_graphic(scon->dcl.con)) {
+        return true;
+    }
+    slot = sdl2_touch_slot_for_pointer(scon, pointer_id, false);
+
