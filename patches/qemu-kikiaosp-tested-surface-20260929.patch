+static void virgl_trace_slow_submit(uint32_t ctx_id, uint32_t bytes,
+                                    uint32_t elapsed_us, const void *buffer)
+{
+    const uint32_t *dwords = buffer;
+    uint32_t counts[256] = { 0 };
+    uint32_t max_lengths[256] = { 0 };
+    uint32_t first_cmd[8];
+    uint32_t first_obj[8];
+    uint32_t first_len[8];
+    char summary[2048];
+    uint32_t total_dwords = bytes / sizeof(uint32_t);
+    uint32_t offset = 0;
+    uint32_t commands = 0;
+    uint32_t invalid = 0;
+    size_t used = 0;
+    int n;
+
+    while (offset < total_dwords) {
+        uint32_t header = ldl_le_p(&dwords[offset]);
+        uint32_t length = header >> 16;
+        uint32_t cmd = header & 0xff;
+        uint32_t obj = (header >> 8) & 0xff;
+
+        if (length > total_dwords - offset - 1) {
+            invalid = 1;
+            break;
+        }
+        counts[cmd]++;
+        max_lengths[cmd] = MAX(max_lengths[cmd], length);
+        if (commands < G_N_ELEMENTS(first_cmd)) {
+            first_cmd[commands] = cmd;
+            first_obj[commands] = obj;
+            first_len[commands] = length;
+        }
+        commands++;
+        offset += length + 1;
+    }
+
+    n = g_snprintf(summary, sizeof(summary), "n=%u invalid=%u head=",
+                   commands, invalid);
+    used = MIN((size_t)n, sizeof(summary) - 1);
+    for (uint32_t i = 0; i < MIN(commands, G_N_ELEMENTS(first_cmd)); i++) {
+        n = g_snprintf(summary + used, sizeof(summary) - used,
+                       "%s%02x/%02x/%u", i ? "," : "",
+                       first_cmd[i], first_obj[i], first_len[i]);
+        if (n < 0 || (size_t)n >= sizeof(summary) - used) {
+            used = sizeof(summary) - 1;
+            break;
+        }
+        used += n;
+    }
+    n = g_snprintf(summary + used, sizeof(summary) - used, " hist=");
+    if (n > 0 && (size_t)n < sizeof(summary) - used) {
+        used += n;
+    }
+    for (uint32_t i = 0; i < G_N_ELEMENTS(counts); i++) {
+        if (!counts[i] || used >= sizeof(summary) - 1) {
+            continue;
+        }
+        n = g_snprintf(summary + used, sizeof(summary) - used,
+                       "%s%02x:%u:%u", used && summary[used - 1] != '=' ? "," : "",
+                       i, counts[i], max_lengths[i]);
+        if (n < 0 || (size_t)n >= sizeof(summary) - used) {
+            used = sizeof(summary) - 1;
+            break;
+        }
+        used += n;
+    }
+
+    trace_kiki_virgl_submit_slow(ctx_id, bytes, elapsed_us, summary);
+}
