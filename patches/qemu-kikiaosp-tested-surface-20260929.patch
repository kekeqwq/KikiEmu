+        sdl2_end_pointer_touch(scon, slot, hwnd, pointer_id,
+                               "WM_POINTERCAPTURECHANGED");
+        return true;
+    }
+    if (message == WM_POINTERUP) {
+        sdl2_end_pointer_touch(scon, slot, hwnd, pointer_id,
+                               "WM_POINTERUP");
+        return true;
+    }
+    if (!GetPointerType(pointer_id, &pointer_type) ||
+        pointer_type != PT_TOUCH ||
+        !GetPointerTouchInfo(pointer_id, &touch_info)) {
+        sdl2_touch_trace_event("pointer-ignored", hwnd, pointer_id, slot,
+                               0, 0, "not-touch-or-no-touch-info");
+        return true;
+    }
+
+    if (message == WM_POINTERDOWN) {
+        if (slot < 0) {
+            slot = sdl2_touch_slot_for_pointer(scon, pointer_id, true);
+        }
+        type = INPUT_MULTI_TOUCH_TYPE_BEGIN;
+    } else if (message == WM_POINTERUPDATE) {
+        if (slot < 0) {
+            return true;
+        }
+        type = INPUT_MULTI_TOUCH_TYPE_UPDATE;
+    }
+    if (slot < 0) {
+        sdl2_touch_trace_event("pointer-dropped", hwnd, pointer_id, slot,
+                               0, 0, "touch-slot-limit");
+        return true;
+    }
+
+    point = touch_info.pointerInfo.ptPixelLocation;
+    if (!ScreenToClient(hwnd, &point)) {
+        sdl2_touch_trace_event("pointer-error", hwnd, pointer_id, slot,
+                               point.x, point.y, "ScreenToClient-failed");
+        return true;
+    }
+    SDL_GL_GetDrawableSize(scon->real_window, &drawable_w, &drawable_h);
+    if (drawable_w <= 0 || drawable_h <= 0 ||
+        surface_width(scon->surface) <= 0 ||
+        surface_height(scon->surface) <= 0) {
+        return true;
+    }
+    x = (int64_t)point.x * surface_width(scon->surface) / drawable_w;
+    y = (int64_t)point.y * surface_height(scon->surface) / drawable_h;
+    x = CLAMP(x, 0, surface_width(scon->surface) - 1);
+    y = CLAMP(y, 0, surface_height(scon->surface) - 1);
+
+    qemu_input_touch_event(scon->dcl.con, scon->touch_slots, slot,
+                           surface_width(scon->surface),
+                           surface_height(scon->surface), x, y, type, &err);
+    if (err) {
+        warn_report_err(err);
+    }
+    scon->touch_mouse_suppress_until = SDL_GetTicks() + 120;
+    sdl2_touch_trace_event(message == WM_POINTERDOWN ? "WM_POINTERDOWN" :
+                           "WM_POINTERUPDATE", hwnd, pointer_id, slot,
+                           x, y, "touch-forwarded");
+    return true;
+}
