+    guint64 interval_max_us;
+} KikiSdlProfile;
+
+static KikiSdlProfile kiki_sdl_profile;
+
+static FILE *kiki_sdl_profile_file(void)
+{
+    const char *path;
+
+    if (!kiki_sdl_profile.checked) {
+        kiki_sdl_profile.checked = true;
+        path = g_getenv("KIKI_SDL_PROFILE_PATH");
+        if (path && *path) {
+            kiki_sdl_profile.file = fopen(path, "a");
+            if (kiki_sdl_profile.file) {
+                kiki_sdl_profile.period_start_us = g_get_monotonic_time();
+            }
+        }
+    }
+
+    return kiki_sdl_profile.file;
+}
+
+static void kiki_sdl_profile_record(gint64 callback_start_us,
+                                    gint64 blit_start_us,
+                                    gint64 swap_start_us,
+                                    gint64 swap_end_us)
+{
+    KikiSdlProfile *profile = &kiki_sdl_profile;
+    gint64 interval_us;
+    guint64 callback_us;
+    guint64 blit_us;
+    guint64 swap_us;
+    gint64 now_us = swap_end_us;
+    double span_s;
+
+    if (!kiki_sdl_profile_file()) {
+        return;
+    }
+
+    callback_us = swap_end_us - callback_start_us;
+    blit_us = swap_start_us - blit_start_us;
+    swap_us = swap_end_us - swap_start_us;
+    profile->swaps++;
+    profile->callback_total_us += callback_us;
+    profile->callback_max_us = MAX(profile->callback_max_us, callback_us);
+    profile->blit_total_us += blit_us;
+    profile->blit_max_us = MAX(profile->blit_max_us, blit_us);
+    profile->swap_total_us += swap_us;
+    profile->swap_max_us = MAX(profile->swap_max_us, swap_us);
+
+    if (profile->last_swap_us) {
+        interval_us = now_us - profile->last_swap_us;
+        if (interval_us > G_USEC_PER_SEC) {
+            profile->idle_gaps++;
+        } else {
+            profile->interval_samples++;
+            profile->interval_total_us += interval_us;
+            profile->interval_max_us = MAX(profile->interval_max_us,
+                                           interval_us);
+            profile->stalls_33ms += interval_us > 33333;
+            profile->stalls_50ms += interval_us > 50000;
+            profile->stalls_100ms += interval_us > 100000;
+        }
+    }
+    profile->last_swap_us = now_us;
+
+    span_s = (now_us - profile->period_start_us) / (double)G_USEC_PER_SEC;
+    if (span_s < 5.0) {
+        return;
+    }
+
+    fprintf(profile->file,
+            "KIKI-QEMU-SDL-PROFILE span=%.3fs flush=%u swaps=%u "
+            "fps=%.2f swap_interval=%d frame_avg=%.3fms frame_max=%.3fms "
+            "stalls33=%u stalls50=%u stalls100=%u idle_gaps=%u "
+            "callback_avg=%.3fms callback_max=%.3fms "
+            "blit_avg=%.3fms blit_max=%.3fms "
+            "swap_avg=%.3fms swap_max=%.3fms\n",
+            span_s, profile->swaps, profile->swaps,
+            profile->swaps / span_s, SDL_GL_GetSwapInterval(),
+            profile->interval_samples ?
+                profile->interval_total_us / 1000.0 /
+                    profile->interval_samples : 0.0,
+            profile->interval_max_us / 1000.0,
+            profile->stalls_33ms, profile->stalls_50ms,
+            profile->stalls_100ms, profile->idle_gaps,
+            profile->swaps ? profile->callback_total_us / 1000.0 /
+                    profile->swaps : 0.0,
+            profile->callback_max_us / 1000.0,
+            profile->swaps ? profile->blit_total_us / 1000.0 /
+                    profile->swaps : 0.0,
+            profile->blit_max_us / 1000.0,
+            profile->swaps ? profile->swap_total_us / 1000.0 /
+                    profile->swaps : 0.0,
+            profile->swap_max_us / 1000.0);
+    fflush(profile->file);
+
+    profile->period_start_us = now_us;
+    profile->swaps = 0;
+    profile->interval_samples = 0;
+    profile->stalls_33ms = 0;
+    profile->stalls_50ms = 0;
+    profile->stalls_100ms = 0;
+    profile->idle_gaps = 0;
+    profile->callback_total_us = 0;
+    profile->callback_max_us = 0;
+    profile->blit_total_us = 0;
+    profile->blit_max_us = 0;
+    profile->swap_total_us = 0;
+    profile->swap_max_us = 0;
+    profile->interval_total_us = 0;
+    profile->interval_max_us = 0;
+}
